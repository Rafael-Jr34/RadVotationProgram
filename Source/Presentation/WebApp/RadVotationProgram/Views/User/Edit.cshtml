@model EditUserViewModel
@{
  
    ViewData["Title"] = "User Maintenance";
}
<div class="col-12 col-md-6 offset-md-3 ">
    <div class="card  border-success">
        <div class="card-header  bg-success text-light">
            <h5 class="text-center">Edit @Model.Username User</h5>
        </div>
        <div class="card-body  ">
            <form class="row g-3" asp-controller="User" asp-action="Edit" method="POST">
                <input type="hidden" asp-for="Id" />
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input type="text" class="form-control" asp-for="Name" placeholder="Pedro">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input type="text" class="form-control" asp-for="LastName" placeholder="Francisco">
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input type="email" class="form-control" asp-for="Email" placeholder="myemaila@@gmail.com">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label"> User Name</label>
                    <input type="text" class="form-control" asp-for="Username" placeholder="Admin121">
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        @{
                        <option disabled>Select a Role</option>
                            #region Role Selection Logic
                                                                                    
                            if (Model.Role == "A")
                            {
                                <option value="A" selected>Administrator</option>
                                <option value="B">Political Leader</option>
                            }
                            else
                            {
                                <option value="A">Administrator</option>
                                <option value="B" selected>Political Leader</option>
                            }
                            #endregion
                        }
                        
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="col-md-9">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input type="password" class="form-control" asp-for="Password" id="Password">
                    <span asp-validation-for="Password" class="text-danger"></span>

                </div>

                <div class="col-md-9">
                    <label asp-for="VerifiedPassword" class="form-label">Confirm Password</label>
                    <input type="password" class="form-control" asp-for="VerifiedPassword" id="VerifiedPassword">
                    <span asp-validation-for="VerifiedPassword" class="text-danger"></span>

                </div>

                <div class="col-12">
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-warning float-end">Go Back</a>
                    <button type="submit" class="btn btn-primary float-end me-2">Save</button>

                </div>
            </form>
        </div>
    </div>
</div>