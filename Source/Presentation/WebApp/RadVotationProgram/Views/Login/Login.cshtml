@model UserLoginViewModel
@{
    string error = ViewBag.ErrorMessage ?? string.Empty;
    ViewData["Title"] = "User Login Page";
    Layout = "_LayoutAnonymous";

}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">User Login</h2>
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            @error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-asp-controller="Login" asp-action="LoginUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">User Name</label>
                            <input asp-for="Name"
                                   type="text"
                                   class="form-control"
                                   placeholder="Enter user name"
                                   required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter password"
                                   required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
